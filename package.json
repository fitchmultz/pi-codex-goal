  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "codex",
    "goal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-codex-goal.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-codex-goal/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-codex-goal#readme",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
